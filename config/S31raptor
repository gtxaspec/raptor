#!/bin/sh
# S31raptor -- Raptor Streaming System init script

CONF=/etc/raptor.conf
RUNDIR=/var/run/rss
SHMDIR=/dev/shm

# Called from a hook: refuse, see run_hooks.
if [ -n "$S31RAPTOR_HOOK" ]; then
	echo "S31raptor: cannot run from a hook (the stack is locked)" >&2
	exit 1
fi

# Re-exec under an exclusive lock so two runs cannot interleave. busybox
# flock takes no -w; a run is bounded by stop_daemon's own waits anyway.
if [ "$1" != watch ] && [ -z "$S31RAPTOR_LOCKED" ] && command -v flock >/dev/null 2>&1; then
	mkdir -p "$RUNDIR"
	S31RAPTOR_LOCKED=1 exec flock "$RUNDIR/.lock" "$0" "$@"
fi

# Environment the daemons read at start, set per camera (for example
# RSS_SCL_RING_DIV for the Infinity6C HAL). Every assignment is exported.
if [ -r /etc/default/raptor ]; then
	set -a
	. /etc/default/raptor
	set +a
fi

# Executables in /etc/raptor.d run with "stop" before any daemon goes down and
# with "start" once the stack is up. They are for processes outside the stack
# that call into the video pipeline: those must be off it while rvd tears it
# down (on SigmaStar, a call into a destroyed ISP channel oopses the vendor MI
# module and leaves its device locked, so the next rvd hangs).
#
# Hooks run as root inside the held lock, so each one is bounded by
# HOOK_TIMEOUT seconds (RAPTOR_HOOK_TIMEOUT in /etc/default/raptor, default
# 10) and then killed. One that is not root-owned, or is writable by group or
# others, is skipped, and so is every hook if the directory is. A hook must
# not call S31raptor: it inherits the lock (S31RAPTOR_LOCKED), so the call is
# not blocked but runs unlocked inside this run and runs the hooks again, which
# recurses until the timeout. S31RAPTOR_HOOK makes the call an error instead.
HOOKDIR=/etc/raptor.d
HOOK_TIMEOUT=${RAPTOR_HOOK_TIMEOUT:-10}

# root-owned and not writable by group or others: hook_trusted <path>
hook_trusted() {
	read -r uid mode <<-EOF
		$(stat -L -c '%u %a' "$1" 2>/dev/null)
	EOF
	[ "$uid" = 0 ] && [ $((0$mode & 022)) -eq 0 ]
}

run_hooks() {
	[ -d "$HOOKDIR" ] || return 0
	if ! hook_trusted "$HOOKDIR"; then
		printf '  hooks %s skipped (not root-owned or writable by others)\n' "$HOOKDIR"
		return 0
	fi
	for h in "$HOOKDIR"/*; do
		[ -f "$h" ] || continue
		[ -x "$h" ] || continue
		if ! hook_trusted "$h"; then
			printf '  hook %s skipped (not root-owned or writable by others)\n' "${h##*/}"
			continue
		fi
		if command -v timeout >/dev/null 2>&1; then
			S31RAPTOR_HOOK=1 timeout -s KILL "$HOOK_TIMEOUT" "$h" "$1"
		else
			S31RAPTOR_HOOK=1 "$h" "$1"
		fi
		rc=$?
		[ $rc -eq 0 ] || printf '  hook %s %s failed (status %d)\n' "${h##*/}" "$1" "$rc"
	done
}

# Read a boolean from raptor.conf: config_bool <section> <key> <default>
config_bool() {
	val=$(raptorctl config get "$1" "$2" 2>/dev/null | tr -d '\r\n')
	val=$(printf '%s' "${val:-$3}" | tr 'A-Z' 'a-z')
	case "$val" in
		true | yes | 1 | on) return 0 ;;
		*) return 1 ;;
	esac
}

# Start a daemon, report status: start_daemon <name> [env_prefix]
start_daemon() {
	name=$1
	shift
	if [ ! -e "/usr/bin/$name" ]; then
		printf "  %-4s skipped (not installed)\n" "$name"
		return
	fi
	if [ ! -x "/usr/bin/$name" ]; then
		printf "  %-4s skipped (not executable)\n" "$name"
		return
	fi
	if ! daemon_enabled "$name"; then
		printf "  %-4s disabled\n" "$name"
		return
	fi
	if [ $# -gt 0 ]; then
		env "$@" start-stop-daemon -S -b -x /usr/bin/$name -- -c "$CONF"
	else
		start-stop-daemon -S -b -x /usr/bin/$name -- -c "$CONF"
	fi
	if [ $? -eq 0 ]; then
		printf "  %-4s started\n" "$name"
	else
		printf "  %-4s FAILED\n" "$name"
	fi
}

# Map daemon name to config section and default enabled state
daemon_section() {
	case $1 in
		rvd) echo "sensor" ;;
		rsd) echo "rtsp" ;;
		rsd-555) echo "rtsp" ;;
		rad) echo "audio" ;;
		rhd) echo "http" ;;
		rod) echo "osd" ;;
		ric) echo "ircut" ;;
		rmr) echo "recording" ;;
		rmd) echo "motion" ;;
		rtd) echo "telematics" ;;
		rcd) echo "cameras" ;;
		rwd) echo "webrtc" ;;
		rwc) echo "webcam" ;;
		rsp) echo "push" ;;
		rsr) echo "srt" ;;
		*) echo "$1" ;;
	esac
}

daemon_default_enabled() {
	case $1 in
		rmr | rmd | rwc | rsp | rsr | rsd-555 | rcd) echo "false" ;;
		*) echo "true" ;;
	esac
}

# Should a daemon start? Its own section decides, normally. rmr hosts two
# features and runs fine with recording off ("timelapse only -- recording
# stays off"), so a timelapse-only config must also bring it up: gating on
# [recording] alone left [timelapse] enabled = true written and honoured,
# but nothing ever started the daemon that reads it.
daemon_enabled() {
	config_bool "$(daemon_section $1)" "enabled" "$(daemon_default_enabled $1)" && return 0
	case $1 in
		rmr) config_bool "timelapse" "enabled" "false" ;;
		*) return 1 ;;
	esac
}

# The recording path outlives a web request when memory runs out
protect() {
	for d in "$@"; do
		case $d in
			rvd | rcd | rmr | rtd)
				for p in $(pidof "$d"); do echo -500 >"/proc/$p/oom_score_adj" 2>/dev/null; done
				;;
		esac
	done
}

# rad: preload libimp-nodbg if available to avoid competing IMP debug thread
daemon_env() {
	[ "$1" = rad ] && [ -f /usr/lib/libimp-nodbg.so ] && echo LD_PRELOAD=/usr/lib/libimp-nodbg.so
}

start() {
	echo "Starting Raptor Streaming System..."
	mkdir -p "$RUNDIR"

	# RVD must start first -- it creates SHM rings
	start-stop-daemon -S -b -x /usr/bin/rvd -- -c "$CONF"
	printf "  %-4s started\n" "rvd"

	# Wait for main ring (up to 5 seconds)
	i=0
	while [ $i -lt 50 ] && [ ! -e ${SHMDIR}/rss_ring_main ]; do
		usleep 100000
		i=$((i + 1))
	done

	if [ ! -e ${SHMDIR}/rss_ring_main ]; then
		printf "  rvd  FAILED (no ring after 5s)\n"
		exit 1
	fi

	start_daemon rad $(daemon_env rad)
	start_daemon rtd
	# external cameras fill sN_* rings before the consumers open them
	start_daemon rcd

	# Core daemons
	start_daemon rod
	start_daemon rsd
	start_daemon rsd-555
	start_daemon rhd
	start_daemon ric
	start_daemon rmr
	start_daemon rmd
	start_daemon rwd
	start_daemon rsp
	start_daemon rsr

	protect rvd rcd rmr rtd

	# Bring back whatever dies (an OOM kill must not end recording)
	watched=""
	for d in rad rtd rcd rod rsd rsd-555 rhd ric rmr rmd rwd rsp rsr; do
		pidof "$d" >/dev/null && watched="$watched $d"
	done
	start-stop-daemon -S -b -m -p "$RUNDIR/watch.pid" -x /bin/sh -- "$0" watch $watched

	run_hooks start

	echo "Done."
}

crash_loop() {
	f="$RUNDIR/restarts.$1"
	read up _ </proc/uptime
	now=${up%.*}
	first=$now
	n=0
	[ -f "$f" ] && read first n <"$f"
	[ $((now - first)) -gt 600 ] && first=$now && n=0
	n=$((n + 1))
	echo "$first $n" >"$f"
	[ $n -gt 5 ]
}

watch() {
	watched="$*"
	while sleep 5; do
		if ! pidof rvd >/dev/null; then
			if crash_loop rvd; then
				logger -t raptor "rvd keeps dying, giving up"
				exit 0
			fi
			logger -t raptor "rvd died, restarting all"
			S31RAPTOR_LOCKED='' S31RAPTOR_WATCH=1 "$0" restart >/dev/null 2>&1
			exit 0
		fi
		keep=""
		for d in $watched; do
			if ! pidof "$d" >/dev/null; then
				if crash_loop "$d"; then
					logger -t raptor "$d keeps dying, giving up"
					continue
				fi
				logger -t raptor "$d died, restarting"
				env $(daemon_env "$d") start-stop-daemon -S -b -x /usr/bin/$d -- -c "$CONF"
				sleep 1
				protect "$d"
			fi
			keep="$keep $d"
		done
		watched=$keep
	done
}

stop_daemon() {
	pid=$(pidof "$1") || return
	kill "$pid" 2>/dev/null
	i=0
	while [ $i -lt 30 ] && kill -0 "$pid" 2>/dev/null; do
		sleep 0.1
		i=$((i + 1))
	done
	if kill -0 "$pid" 2>/dev/null; then
		kill -9 "$pid" 2>/dev/null
		printf "  %-4s killed\n" "$1"
	else
		printf "  %-4s stopped\n" "$1"
	fi
	rm -f "$RUNDIR/$1.pid" "$RUNDIR/$1.sock"
}

stop() {
	echo "Stopping Raptor Streaming System..."
	start-stop-daemon -K -q -p "$RUNDIR/watch.pid" 2>/dev/null
	rm -f "$RUNDIR/watch.pid"
	[ -n "$S31RAPTOR_WATCH" ] || rm -f "$RUNDIR"/restarts.*

	run_hooks stop

	# Stop consumers first, then producer (RVD) last
	for d in rsr rsp rwd rmd rmr rcd rtd ric rhd rsd rsd-555 rod rad rvd; do
		stop_daemon $d
	done

	rm -f ${SHMDIR}/rss_ring_* ${SHMDIR}/rss_osd_*

	echo "Done."
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	watch)
		shift
		watch "$@"
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
